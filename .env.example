# ---------------------------------------------------------------- Supabase --
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses RLS — never expose to the browser (Tech Spec §47).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------ Stripe --
# GBP. Client decision 2026-09-25 (supersedes the ₦ figures in Brief §48).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --------------------------------------------------------------- Email --
# D-27, D-152 — the order confirmation (the durable medium for immediate
# digital supply), to the person who paid: a mission, or a gift with its code.
# WLA emails no gift recipient (D-149).
# Without these, purchases and gifts still work and the gift code is shown in
# the purchaser's account, but no confirmation is sent, which the law requires:
# set them before selling. Needs a verified sending domain in Resend.
#
# In `next dev` only, with no Resend settings, mail can go to the local Mailpit
# (D-145). A loopback address only. It can't switch on in a production build.
# WLA_DEV_MAILPIT_URL=http://127.0.0.1:55324
# RESEND_API_KEY=re_...
# EMAIL_FROM="Within Lab Academy <hello@yourdomain>"

# Absolute origin used in Journal, QR and gift-message links (D-149).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Trusted server origin for Stripe success/cancel URLs and access-email links.
# Set to https://your-domain.com in production and http://localhost:3000 locally.
SITE_URL=http://localhost:3000

# Server-only bearer secret for the scheduled checkout reconciliation route.
# Configure the same random value in Vercel and send it only from Vercel Cron.
# CRON_SECRET=

# ------------------------------------------------- Child code encryption --
# D-143. Encrypts the copy of a child's access code that a parent can view.
# Server only: never NEXT_PUBLIC_, never in the database, different in every
# environment. 32 random bytes as base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it codes still work, but new ones can't be viewed again.
# See docs/CHILD-CODE-ENCRYPTION.md for rotation and recovery.
# CHILD_CODE_ENCRYPTION_KEY=
# CHILD_CODE_ENCRYPTION_KEY_PREVIOUS=

# ------------------------------------------------------------- Monitoring --
# Sprint 10 (Tech Spec §54, OPS-01). Not yet wired.
# SENTRY_DSN=

# Journal (D-137): the PUBLIC website's origin, where readers find articles
# (the Lovable site). The studio links published articles there. Unset, it
# shows its own read-only view instead. Not a secret.
# NEXT_PUBLIC_JOURNAL_SITE_URL=https://your-public-site.example

# --------------------------------------------------------------- Privacy --
# D-148. Protects /api/cron/privacy, which retries unfinished account closures
# (stored files, auth users) and removes orphaned evidence files. At least 16
# characters; Vercel Cron sends it as a Bearer token. Unset, the endpoint
# refuses every call. The retention periods themselves run in the database.
# CRON_SECRET=
# D-157. The deletion ledger outside the database, which a restore needs to
# redo deletions made after the backup. Both or neither. The directory must not
# be anything a database restore rolls back; on Vercel it can't be a local
# directory at all (OPEN-30). The key is 32 random bytes:
#   openssl rand -base64 32
# Keep a copy where a restore operator can get it, never in the database.
# PRIVACY_LEDGER_DIR=
# PRIVACY_LEDGER_KEY=
# D-152. WLA's published Terms & Conditions, linked at checkout and in the
# order confirmation. Not a secret.
# NEXT_PUBLIC_TERMS_URL=https://your-public-site.example/terms
